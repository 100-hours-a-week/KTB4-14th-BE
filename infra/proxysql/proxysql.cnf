# 로컬 개발용 ProxySQL 설정
# 앱은 6033으로 접속하고, ProxySQL은 hostgroup 10(MySQL)으로 모든 쿼리를 전달한다.
# 컷오버 시에는 hostgroup 10의 서버만 교체한다.

datadir="/var/lib/proxysql"

admin_variables=
{
    # admin은 컨테이너 내부 접속 전용, radmin은 호스트에서 접속용
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    threads=2
    max_connections=2048
    interfaces="0.0.0.0:6033"
    server_version="8.4.0"
    default_charset="utf8mb4"
    monitor_username="monitor"
    monitor_password="monitor"
    monitor_connect_interval=10000
    monitor_ping_interval=10000
    # 8시간. 앱의 Hikari max-lifetime(25분)보다 길게 유지한다
    wait_timeout=28800000
}

mysql_servers=
(
    {
        address="mysql"
        port=3306
        hostgroup=10
        max_connections=200
    }
)

mysql_users=
(
    {
        username="audigo"
        password="audigo"
        default_hostgroup=10
        # 트랜잭션 안의 쿼리는 같은 hostgroup에 고정
        transaction_persistent=1
        active=1
    }
)
