BASE_URL=https://staging.example.com
# 모든 실행은 명시적으로 Staging임을 확인해야 한다.
CONFIRM_STAGING=true
# STAGING_JWT_SECRET은 여기에 저장하지 않는다. 토큰 갱신 스크립트 실행 시
# 셸의 일회성 환경변수 또는 AWS Secrets Manager 조회값으로만 전달한다.
# 사용자별 토큰은 data/test-ids.json에 넣는다. ACCESS_TOKEN은 읽기 전용
# 단일 계정 Smoke 용도의 대체값이다.
ACCESS_TOKEN=
# 비워 두면 실행 시각(KST)의 YYYY-MM-DD-HH-mm 형식으로 자동 생성한다.
# 같은 분에 서로 다른 시나리오를 실행하면 같은 폴더에 각각 저장된다.
TEST_RUN_ID=
# `scripts/seed-test-user.sh`가 미래 여행을 생성할 때만 필요하다. Staging AI Mock이
# 실제로 연결된 것을 확인한 뒤 명시적으로 true로 전달한다. .env에 고정하지 않는다.
# CONFIRM_AI_MOCK=false

# 로컬 모니터링은 `scripts/monitoring/monitor.sh prepare` 이후 사용한다.
# ACCESS_TOKEN은 위의 기존 값을 사용하거나 data/test-ids.json의 첫 유효 토큰을 사용한다.
# SSH tunnel은 Mac의 127.0.0.1:19104 -> DB EC2의 127.0.0.1:9104으로 별도로 열어둔다.
MONITORING_INTERVAL_SECONDS=5
MONITORING_PRE_SECONDS=30
MONITORING_POST_SECONDS=30
MONITORING_REQUEST_TIMEOUT_MS=3000
MONITORING_BRIDGE_PORT=19105
MONITORING_READY_TIMEOUT_SECONDS=60
# MONITORING_RUNTIME_DIR=monitoring/runtime
# MONITORING_GRAFANA_PASSWORD는 runtime/stack.env에 자동 생성된다. 이 파일·비밀번호를 Git에 저장하지 않는다.

# `scripts/start-staging.sh` / `scripts/stop-staging.sh`에만 필요하다.
# 실제 식별자는 Staging 리소스가 확정된 후 입력한다.
AWS_REGION=
STAGING_INSTANCE_ID=
ECS_CLUSTER=
ECS_SERVICES=
HEALTH_URL=
CONFIRM_STAGING_CONTROL=false

# 지표용 Backend SSH 터널을 사용할 때만 지정한다. BASE_URL은 k6 대상 그대로 둔다.
# MONITORING_BACKEND_URL=http://127.0.0.1:19106
# 원격 HTTP는 JWT 평문 전송 위험 때문에 기본 거부한다. HTTPS/SSH를 권장한다.
# 위험을 이해하고 격리된 Staging JWT에만 명시적으로 허용할 때 사용한다.
# MONITORING_ALLOW_INSECURE_HTTP=false
