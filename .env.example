DB_USERNAME=
DB_PASSWORD=
AUDIGO_JWT_SECRET=
AUDIGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao
AUDIGO_ACCESS_TOKEN_TTL_SECONDS=3600
AUDIGO_REFRESH_TOKEN_TTL_SECONDS=1209600

# Optional server ES deployment: add search-server to the existing active profiles.
# These are examples only. Inject passwords through the deployment secret store.
# SPRING_PROFILES_ACTIVE=prod,search-server
# AUDIGO_CHAT_MESSAGE_SEARCH_MODE=fulltext
# AUDIGO_CHAT_ES_URL=https://elasticsearch.search.svc.cluster.local:9200
# AUDIGO_CHAT_ES_USERNAME=
# AUDIGO_CHAT_ES_PASSWORD=
# AUDIGO_CHAT_ES_INDEX=audigo-chat-messages-v1
# AUDIGO_CHAT_ES_TEXT_CONTRACT=nfc-v1
# AUDIGO_CHAT_SEARCH_SYNC_DATABASE_NAME=audigo
# AUDIGO_CHAT_SEARCH_SYNC_TARGET_INDEX=audigo-chat-messages-v1
# AUDIGO_CHAT_SEARCH_SYNC_TARGET_GENERATION=chat-v1
# AUDIGO_CHAT_SEARCH_SYNC_RECORD_ENABLED=false
# AUDIGO_CHAT_SEARCH_SYNC_WORKER_ENABLED=false
# AUDIGO_CHAT_SEARCH_SYNC_ES_URL defaults to AUDIGO_CHAT_ES_URL; if set, it must match.
# AUDIGO_CHAT_SEARCH_SYNC_ES_USERNAME=
# AUDIGO_CHAT_SEARCH_SYNC_ES_PASSWORD=
